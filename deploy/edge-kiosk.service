[Unit]
Description=Xeneon Edge kiosk (cage + Chromium on tty1)
After=systemd-user-sessions.service edge-display.service
Wants=edge-display.service
Conflicts=getty@tty1.service

[Service]
User=__USER__
PAMName=login
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
Environment=PATH=__NODE_DIR__:/usr/local/bin:/usr/bin:/bin:/snap/bin
ExecStart=/usr/bin/cage -d -- __APP__/bin/kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
